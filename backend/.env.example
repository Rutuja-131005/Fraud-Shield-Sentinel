# FraudShield AI FastAPI Environment Variables
PORT=8000
HOST=0.0.0.0
ENV=development

# Database Configuration (Defaults to SQLite for instant local hackathon execution, supports PostgreSQL)
DATABASE_URL=sqlite:///./fraudshield.db
# PostgreSQL Example: postgresql://user:password@localhost:5432/fraudshield_db

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","*"]

# Risk Engine Thresholds
AUTO_ALERT_THRESHOLD=70
REVIEW_THRESHOLD=40
XGBOOST_WEIGHT=0.60
ISOLATION_FOREST_WEIGHT=0.40
